# Copy this file to .env and fill in real values.
# Never commit the real .env file.

# ---- Domain / Cloudflare ----
DOMAIN=example.com
ACME_EMAIL=you@example.com
CF_TUNNEL_TOKEN=your_cloudflare_tunnel_token_here
CF_DNS_API_TOKEN=your_cloudflare_dns_api_token_here

# ---- Authelia ----
# Generate each with: openssl rand -hex 32
AUTHELIA_SESSION_SECRET=changeme_generate_random_64char_string
AUTHELIA_STORAGE_ENCRYPTION_KEY=changeme_generate_random_64char_string

# ---- Nextcloud ----
NEXTCLOUD_DB_PASSWORD=changeme
NEXTCLOUD_ADMIN_PASSWORD=changeme

# ---- Vaultwarden ----
VAULTWARDEN_ADMIN_TOKEN=changeme

# ---- Immich ----
IMMICH_DB_PASSWORD=changeme

# ---- Paperless-ngx ----
PAPERLESS_DB_PASSWORD=changeme
PAPERLESS_SECRET_KEY=changeme_generate_random_string
PAPERLESS_ADMIN_PASSWORD=changeme

# ---- Grafana ----
GRAFANA_ADMIN_PASSWORD=changeme
